module Main where

import Prelude

import ArgParse.Basic (ArgParser)
import ArgParse.Basic as ArgParser
import Data.Array as Array
import Data.Either (Either(..))
import Data.Map as Map
import Data.Maybe (Maybe(..))
import Data.Set as Set
import Data.String as String
import Data.Traversable (for_)
import Dodo as Dodo
import Effect (Effect)
import Effect.Aff (Aff, attempt, launchAff_)
import Effect.Class (liftEffect)
import Effect.Class.Console as Console
import Effect.Ref as Ref
import Node.Encoding (Encoding(..))
import Node.FS.Aff as FS
import Node.FS.Perms as Perms
import Node.Path (FilePath)
import Node.Path as Path
import Node.Process as Process
import PureScript.Backend.Optimizer.Codegen.Go (codegenModule)
import PureScript.Backend.Optimizer.Codegen.Go.Builder (basicBuildMain)
import PureScript.Backend.Optimizer.CoreFn (Ident(..), ModuleName(..), Qualified(..))
import PureScript.Backend.Optimizer.Reachability (pruneModule, reachableFromEntry)
import PureScript.Backend.Optimizer.Semantics.Foreign (coreForeignSemantics)

type BuildArgs =
  { coreFnDir :: FilePath
  , outputDir :: FilePath
  , foreignDir :: FilePath
  , mainModule :: String
  }

argParser :: ArgParser BuildArgs
argParser =
  ArgParser.fromRecord
    { coreFnDir:
        ArgParser.argument [ "--corefn-dir" ]
          "Path to input directory containing corefn.json files (default ./output)."
          # ArgParser.default (Path.concat [ ".", "output" ])
    , outputDir:
        ArgParser.argument [ "--output-dir" ]
          "Path to output directory for Go files (default ./output-go-opt)."
          # ArgParser.default (Path.concat [ ".", "output-go-opt" ])
    , foreignDir:
        ArgParser.argument [ "--foreign-dir" ]
          "Path to the per-package Go FFI layer (default ./foreign). See foreign/README.md."
          # ArgParser.default (Path.concat [ ".", "foreign" ])
    , mainModule:
        ArgParser.argument [ "--main" ]
          "Entry module whose `main :: Effect _` is run (default Main)."
          # ArgParser.default "Main"
    }
    <* ArgParser.flagHelp

main :: Effect Unit
main = do
  args <- Array.drop 2 <$> Process.argv
  case ArgParser.parseArgs "backend-go" "PureScript Go backend (optimizer IR)." argParser args of
    Left err -> Console.error (ArgParser.printArgError err)
    Right buildArgs -> launchAff_ (build buildArgs)

build :: BuildArgs -> Aff Unit
build args = do
  -- Accumulate every built module, then in onCodegenAfter compute reachability
  -- from `main` and emit only the reachable bindings. Pruning needs the global
  -- reference graph, so we can't emit per-module as we go.
  modulesRef <- liftEffect (Ref.new [])
  basicBuildMain
    { resolveCoreFnDirectory: pure args.coreFnDir
    , resolveExternalDirectives: pure Map.empty
    , analyzeCustom: \_ _ -> Nothing
    , foreignSemantics: coreForeignSemantics
    , onCodegenBefore: mkdirp args.outputDir
    , onPrepareModule: \_ coreFnMod -> pure coreFnMod
    , onCodegenModule: \_ _ backendMod _ ->
        liftEffect (Ref.modify_ (_ <> [ backendMod ]) modulesRef)
    , onCodegenAfter: do
        modules <- liftEffect (Ref.read modulesRef)
        let
          entry = Qualified (Just (ModuleName args.mainModule)) (Ident "main")
          reachable = reachableFromEntry entry modules
        -- emit only modules with a reachable binding, each pruned to its reachable set
        for_ modules \backendMod ->
          case pruneModule reachable backendMod of
            Nothing -> pure unit
            Just pruned -> do
              let
                ModuleName name = pruned.name
                formatted = Dodo.print Dodo.plainText Dodo.twoSpaces (codegenModule { intTags: false } pruned)
              FS.writeTextFile UTF8 (Path.concat [ args.outputDir, goIdent name <> ".go" ]) formatted
        copyPackageForeigns args.foreignDir args.outputDir
          (map (\m -> case m.name of ModuleName n -> n) modules)
        let
          entryGo = String.joinWith "\n"
            [ "package main"
            , ""
            , "// Entry point generated by backend-go for module " <> args.mainModule
            , "func main() {"
            , "\t_runEffect(_force(" <> goIdent args.mainModule <> "_main))"
            , "}"
            , ""
            ]
        -- NB: not "_entry.go" — the Go toolchain ignores files starting with "_".
        FS.writeTextFile UTF8 (Path.concat [ args.outputDir, "entrypoint.go" ]) entryGo
    , traceIdents: Set.empty
    }

-- | Link in the Go FFI for every PureScript package the program depends on that
-- | has one. `foreign/<Module.Name>.go` is copied to the output as
-- | `<Module_Name>_foreign.go`; `foreign/README.md` states the convention and
-- | why it is not simply more of `runtime.go`.
-- |
-- | THE BUILT SET, NOT THE REACHABLE SET. A module can be pruned away entirely
-- | and still have its foreigns called from elsewhere — `Foreign.Object.ST`
-- | emits no Go file at all, yet the surviving `Foreign_Object.go` calls
-- | `Foreign_Object_ST_poke`. Keying on what survived pruning would miss exactly
-- | the cases that make a build fail to link.
-- |
-- | Over-inclusion is therefore the safe direction, and it is cheap: an unused
-- | file contributes package-level `var`s that Go permits and the linker drops.
-- | Omission is a build that does not link.
-- |
-- | A missing or unreadable `foreign/` is NOT an error. The directory is a
-- | facility, and a corefn dir that needs nothing from it must still build —
-- | which is also what keeps this compatible with any caller that has not heard
-- | of `--foreign-dir`.
copyPackageForeigns :: FilePath -> FilePath -> Array String -> Aff Unit
copyPackageForeigns foreignDir outputDir names =
  attempt (FS.readdir foreignDir) >>= case _ of
    Left _ -> pure unit
    Right files -> do
      let available = Set.fromFoldable files
      for_ (Array.nub names) \name ->
        when (Set.member (name <> ".go") available) do
          body <- FS.readTextFile UTF8 (Path.concat [ foreignDir, name <> ".go" ])
          FS.writeTextFile UTF8
            (Path.concat [ outputDir, goIdent name <> "_foreign.go" ])
            body
          Console.log ("  + foreign " <> name)

-- | A PureScript module name as a Go identifier prefix: dots become
-- | underscores, which is the mangling the codegen and every hand-written
-- | foreign already assume.
goIdent :: String -> String
goIdent = String.replaceAll (String.Pattern ".") (String.Replacement "_")

mkdirp :: FilePath -> Aff Unit
mkdirp = flip FS.mkdir' { recursive: true, mode: Perms.mkPerms Perms.all Perms.all Perms.all }
