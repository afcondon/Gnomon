      DeriveGeneric
      DerivingStrategies
      EmptyDataDecls
      FlexibleContexts
      KindSignatures
      LambdaCase
      MultiParamTypeClasses
      NoImplicitPrelude
      PatternGuards
      PatternSynonyms
      RankNTypes
      RecordWildCards
      OverloadedStrings
      ScopedTypeVariables
      TupleSections
      ViewPatterns
  ghc-options: -Wall -O0
  build-depends:
