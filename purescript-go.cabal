name:           purescript-go
version:        0.0.1
synopsis:       PureScript Programming Language Go Back-end (spike)
description:    Go backend for PureScript. Consumes CoreFn JSON (purs --codegen corefn) and emits Go source via a statement-form Go AST + pretty-printer + gofmt post-pass. Third turn of the purerl -> Julia -> Python backend genealogy; reaches back to grandparent purerl for the statement-oriented AST/Pretty machinery.
category:       Language
stability:      experimental
homepage:       https://github.com/afcondon/purescript-go#readme
bug-reports:    https://github.com/afcondon/purescript-go/issues
author:         Andrew Condon
maintainer:     Andrew Condon
copyright:      (c) 2026 Andrew Condon
license:        BSD3
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/afcondon/purescript-go

library
  exposed-modules:
      Language.PureScript.Go.CodeGen
      Language.PureScript.Go.CodeGen.AST
      Language.PureScript.Go.CodeGen.Common
      Language.PureScript.Go.CodeGen.Pretty
      Language.PureScript.Go.Foreigns
      Language.PureScript.Go.Make
  other-modules:
      Paths_purescript_go
  hs-source-dirs:
      src
  default-extensions:
      ConstraintKinds
      DataKinds
      DeriveFunctor
      DeriveFoldable
